# Admin CRM (Supabase Magic Link auth) — required for /admin/login
# Honeywell Travel Supabase project (REST: /rest/v1/clients)
VITE_SUPABASE_URL=https://bgbgiazicjfpninnizjn.supabase.co
# Publishable key from Supabase → Project Settings → API
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key-here
# Magic link redirect after email click (production CRM)
VITE_ADMIN_AUTH_REDIRECT_URL=https://www.honeywelltravel.com.cy/admin/packages
# Secret key — local scripts only; do NOT use VITE_ prefix (never ship to the browser)
SUPABASE_SECRET_KEY=sb_secret_your-key-here

# Optional: OpenAI API key for enhanced passenger import column mapping (browser-side)
VITE_OPENAI_API_KEY=

# Resend — server-side only (Vercel env, NOT VITE_ prefix)
RESEND_API_KEY=re_your_resend_api_key

# Travel Hub CRM — server-side only (Vercel env, NOT VITE_ prefix)
# Copy agency API key from Travel Hub CRM → Settings → Agency Profile
CRM_AGENCY_API_KEY=your_crm_agency_api_key
CRM_INBOUND_URL=https://travel-hub-crm.vercel.app/api/leads/inbound
