# Shared backend: Travel Hub CRM Supabase project (same DB as travel-hub-crm)
VITE_SUPABASE_URL=https://nwdyywbtbgdbdwneovme.supabase.co
# Publishable / anon key from Supabase → Project Settings → API Keys
# Either name works; the app accepts both.
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key-here
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
# After-login redirect for admin
VITE_ADMIN_AUTH_REDIRECT_URL=https://www.honeywelltravel.com.cy/admin/packages
# Server-only secret: prefer the legacy JWT service_role key from Supabase → API
# (also accepted as SUPABASE_SERVICE_ROLE_KEY). Do NOT use a VITE_ prefix.
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-jwt
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-jwt

# Optional: OpenAI API key for enhanced passenger import column mapping (browser-side)
VITE_OPENAI_API_KEY=

# Resend — server-side only (Vercel env, NOT VITE_ prefix)
RESEND_API_KEY=re_your_resend_api_key

# Travel Hub CRM — server-side only (Vercel env, NOT VITE_ prefix)
# Copy agency API key from Travel Hub CRM → Settings → Agency Profile
CRM_AGENCY_API_KEY=your_crm_agency_api_key
CRM_INBOUND_URL=https://travel-hub-crm.vercel.app/api/leads/inbound

# XS2Event TEST API — server-side only (Vercel / vercel dev env, NOT VITE_ prefix)
# Never expose these to the browser. Do not use VITE_XS2EVENT_*.
XS2EVENT_API_URL=https://testapi.xs2event.com
XS2EVENT_API_KEY=your_xs2event_test_api_key
