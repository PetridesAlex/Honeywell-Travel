# Admin CRM (Supabase Magic Link auth) — required for /admin/login
# Honeywell Travel Supabase project (REST: /rest/v1/clients)
VITE_SUPABASE_URL=https://bgbgiazicjfpninnizjn.supabase.co
# Publishable key from Supabase → Project Settings → API
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key-here
# Magic link redirect after email click (production CRM)
VITE_ADMIN_AUTH_REDIRECT_URL=https://www.honeywelltravel.com.cy/admin/dashboard
# hCaptcha site key (required when Supabase Auth has captcha protection enabled)
VITE_HCAPTCHA_SITE_KEY=your_hcaptcha_site_key_here
# Secret key — local scripts only; do NOT use VITE_ prefix (never ship to the browser)
SUPABASE_SECRET_KEY=sb_secret_your-key-here

VITE_EMAILJS_SERVICE_ID=service_xxxxxx
VITE_EMAILJS_PUBLIC_KEY=public_xxxxxxxxxxxxx

